{
  "name": "actionauto-tray",
  "version": "1.2.5",
  "description": "Action Auto TimeProof Tray Agent",
  "main": "dist/main.js",
  "author": "Action Auto",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder --win --x64"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "form-data": "^4.0.5",
    "keytar": "^7.9.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "electron": "^42.0.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.actionauto.tray",
    "productName": "Action Auto Tray",
    "publish": {
      "provider": "github",
      "owner": "actionauto-devteam",
      "repo": "suprah-trayapp"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ActionAutoTraySetup.exe"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": ".env", "to": ".env" }
    ]
  }
}
