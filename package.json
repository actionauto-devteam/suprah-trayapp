{
  "name": "actionauto-tray",
  "version": "1.4.10",
  "description": "Suprah AI - Timeproof Clock",
  "main": "dist/main.js",
  "author": "Action Auto",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder --win --x64",
    "build:mac": "tsc && electron-builder --mac --universal"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "form-data": "^4.0.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "electron": "^42.0.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.actionauto.tray",
    "productName": "Suprah AI - Timeproof Clock",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "actionauto-devteam",
      "repo": "suprah-trayapp",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ActionAutoTraySetup.exe"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSScreenRecordingUsageDescription": "Suprah AI - Timeproof Clock captures periodic screenshots to verify timeproof activity.",
        "NSScreenCaptureUsageDescription": "Suprah AI - Timeproof Clock captures periodic screenshots to verify timeproof activity."
      }
    },
    "dmg": {
      "artifactName": "ActionAutoTraySetup.dmg"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": ".env", "to": ".env" }
    ]
  }
}
